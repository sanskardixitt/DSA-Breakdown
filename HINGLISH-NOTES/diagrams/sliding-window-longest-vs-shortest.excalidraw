      "id": "e207-9b4q4c",
      "type": "text",
      "x": 46,
      "y": 171.875,
      "width": 608,
      "height": 206.25,
      "backgroundColor": "transparent",
      "roundness": null,
      "text": "let left = 0, best = 0;\n\nfor (right = 0; right < n; right++) {\n    add(arr[right]);\n\n    while (INVALID) {           <-- KHARAB hai\n        remove(arr[left]); left++;      to REPAIR karo\n    }\n\n    best = max(best, right-left+1);  <-- BAAHAR record\n}",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "e206-qzxz2o",
      "originalText": "let left = 0, best = 0;\n\nfor (right = 0; right < n; right++) {\n    add(arr[right]);\n\n    while (INVALID) {           <-- KHARAB hai\n        remove(arr[left]); left++;      to REPAIR karo\n    }\n\n    best = max(best, right-left+1);  <-- BAAHAR record\n}",
      "lineHeight": 1.25
    },
