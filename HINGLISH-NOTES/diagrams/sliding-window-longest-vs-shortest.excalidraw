      "text": "let left = 0, best = Infinity;\n\nfor (right = 0; right < n; right++) {\n    add(arr[right]);\n\n    while (VALID) {             <-- SAHI hai\n        best = min(best, right-left+1);   ANDAR record\n        remove(arr[left]); left++;        to CHHOTA karo\n    }\n}",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "e212-hbgd16",
      "originalText": "let left = 0, best = Infinity;\n\nfor (right = 0; right < n; right++) {\n    add(arr[right]);\n\n    while (VALID) {             <-- SAHI hai\n        best = min(best, right-left+1);   ANDAR record\n        remove(arr[left]); left++;        to CHHOTA karo\n    }\n}",
      "lineHeight": 1.25
