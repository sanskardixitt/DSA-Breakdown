      "id": "e388-p8zqx0",
      "type": "text",
      "x": 1286,
      "y": 274.5,
      "width": 608,
      "height": 105,
      "backgroundColor": "transparent",
      "roundness": null,
      "text": "INDEX push karo, value nahi (distance bhi milegi).\n\nNEXT greater  -> left->right, st.top < cur pop\nPREV greater  -> right->left, st.top < cur pop\n\nAmortized O(n): har element 1 push, 1 pop.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "e387-z6uagz",
      "originalText": "INDEX push karo, value nahi (distance bhi milegi).\n\nNEXT greater  -> left->right, st.top < cur pop\nPREV greater  -> right->left, st.top < cur pop\n\nAmortized O(n): har element 1 push, 1 pop.",
      "lineHeight": 1.25
    },
