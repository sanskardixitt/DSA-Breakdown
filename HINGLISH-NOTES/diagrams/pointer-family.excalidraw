      "height": 105,
      "backgroundColor": "transparent",
      "roundness": null,
      "text": "slow ek kadam, fast do kadam.\n\nfast end pe -> slow MIDDLE pe.\ncycle hai -> fast slow ko LAP karke milega.\n\nwhile (fast && fast.next)   <-- dono check!",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "e371-uej3d4",
      "originalText": "slow ek kadam, fast do kadam.\n\nfast end pe -> slow MIDDLE pe.\ncycle hai -> fast slow ko LAP karke milega.\n\nwhile (fast && fast.next)   <-- dono check!",
      "lineHeight": 1.25
    },
